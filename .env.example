# Agent bridge base URL of your Switch server (GET /health returns 200 there).
SWITCH_URL=http://127.0.0.1:8000
# A registration key from the Switch Gateway, used once by `python -m injini_floor register`.
SWITCH_REGISTRATION_TOKEN=
# Written by `register`:
INJINI_AGENT_ID=
INJINI_API_KEY=
# The Claude Code agent that writes work orders.
FOREMAN_NAME=foreman
# Optional: a local smart-plug or PLC endpoint that receives {"asset","action":"stop"} when a stop is approved.
STOP_WEBHOOK_URL=
# For the replay tool.
PLANT_ROOM_ID=
